diff --git a/supabase/migrations/20260228_add_super_admin_role.sql b/supabase/migrations/20260228_add_super_admin_role.sql
new file mode 100644
index 0000000..92159d0
--- /dev/null
+++ b/supabase/migrations/20260228_add_super_admin_role.sql
@@ -0,0 +1,34 @@
+-- Add super_admin role to app_role enum
+ALTER TYPE public.app_role ADD VALUE 'super_admin' BEFORE 'admin';
+
+-- Create or update super admin assignment function
+CREATE OR REPLACE FUNCTION public.make_super_admin(_email TEXT)
+RETURNS TABLE (success BOOLEAN, message TEXT)
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = public
+AS $$
+DECLARE
+  v_user_id UUID;
+BEGIN
+  -- Get the user ID from the email
+  SELECT id INTO v_user_id FROM auth.users WHERE email = _email;
+  
+  IF v_user_id IS NULL THEN
+    RETURN QUERY SELECT false, 'User not found with email: ' || _email;
+    RETURN;
+  END IF;
+  
+  -- Remove any existing roles for this user
+  DELETE FROM public.user_roles WHERE user_id = v_user_id;
+  
+  -- Insert only super_admin role
+  INSERT INTO public.user_roles (user_id, role)
+  VALUES (v_user_id, 'super_admin');
+  
+  RETURN QUERY SELECT true, 'User ' || _email || ' is now a SUPER ADMIN';
+END;
+$$;
+
+-- Execute to make marcelinkyambo@gmail.com super admin
+SELECT public.make_super_admin('marcelinkyambo@gmail.com');
diff --git a/supabase/migrations/20260228_make_admin.sql b/supabase/migrations/20260228_make_admin.sql
new file mode 100644
index 0000000..4dca403
--- /dev/null
+++ b/supabase/migrations/20260228_make_admin.sql
@@ -0,0 +1,29 @@
+-- Create or update admin user function
+CREATE OR REPLACE FUNCTION public.make_user_admin(_email TEXT)
+RETURNS TABLE (success BOOLEAN, message TEXT)
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = public
+AS $$
+DECLARE
+  v_user_id UUID;
+BEGIN
+  -- Get the user ID from the email
+  SELECT id INTO v_user_id FROM auth.users WHERE email = _email;
+  
+  IF v_user_id IS NULL THEN
+    RETURN QUERY SELECT false, 'User not found with email: ' || _email;
+    RETURN;
+  END IF;
+  
+  -- Insert admin role if not already present
+  INSERT INTO public.user_roles (user_id, role)
+  VALUES (v_user_id, 'admin')
+  ON CONFLICT (user_id, role) DO NOTHING;
+  
+  RETURN QUERY SELECT true, 'User ' || _email || ' is now an admin';
+END;
+$$;
+
+-- Execute function to make marcelinkyambo@gmail.com admin
+SELECT public.make_user_admin('marcelinkyambo@gmail.com');
