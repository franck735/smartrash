+## 🛠 Implementation Patterns
+
+### Get Household's Trash Status
+```typescript
+// src/hooks/useHouseholdTrash.ts
+import { supabase } from '@/integrations/supabase/client';
+import { useQuery, useMutation } from '@tanstack/react-query';
+
+export function useHouseholdTrash(userId: string) {
+  return useQuery({
+    queryKey: ['trash_status', userId],
+    queryFn: async () => {
+      const { data } = await supabase
+        .from('trash_status')
+        .select('*')
+        .eq('user_id', userId)
+        .single();
+      return data;
+    }
+  });
+}
+
+export function useUpdateTrashStatus() {
+  return useMutation({
+    mutationFn: async (data: { status: string; userId: string }) => {
+      const { error } = await supabase
+        .from('trash_status')
+        .update({ status: data.status, updated_at: new Date() })
+        .eq('user_id', data.userId);
+      if (error) throw error;
+    }
+  });
+}
+```
+
+### Get Full Trash Locations for Driver
+```typescript
+// For route planning
+const { data: fullTrash } = await supabase
+  .from('trash_status')
+  .select(`
+    id,
+    user_id,
+    status,
+    marked_full_at,
+    profiles (
+      latitude,
+      longitude,
+      address,
+      phone
+    )
+  `)
+  .eq('status', 'full');
+```
+
+### Record Pickup
+```typescript
+// After driver completes pickup
+await supabase
+  .from('pickup_records')
+  .insert({
+    household_id: householdId,
+    driver_id: driverId,
+    trash_status_id: trashStatusId,
+    fee_rwf: 500,
+    picked_up_at: new Date()
+  });
+
+// Update trash status
+await supabase
+  .from('trash_status')
+  .update({
+    status: 'picked_up',
+    picked_up_at: new Date(),
+    picked_up_by: driverId
+  })
+  .eq('id', trashStatusId);
+```
+
